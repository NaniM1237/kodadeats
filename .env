# ========================================================
# Eat.in (Kodad) - Production & 24/7 Cloud Configuration
# ========================================================

# Server Port
PORT=3000
NODE_ENV=production
HIDE_OTP=true

# MongoDB Atlas High-Availability Cloud Database
MONGODB_URI=mongodb+srv://kodadeatsadmin:MongoDB%403505@cluster0.au8wsnf.mongodb.net/kodadeats?retryWrites=true&w=majority

# ================= SECURE PAYMENT GATEWAYS =================
# Razorpay Live / Test Credentials (Get from dashboard.razorpay.com -> Settings -> API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# PhonePe Payment Gateway / UPI Credentials (Optional)
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1

# ================= REAL SMS OTP GATEWAY (ZOMATO / SWIGGY STYLE) =================
# Fast2SMS is the easiest & cheapest Indian SMS Gateway (~₹0.15/SMS).
# 1. Sign up at https://www.fast2sms.com
# 2. Copy Dev API Key from Dashboard -> Dev API
FAST2SMS_API_KEY=

# Twilio SMS (Optional Backup)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Kodad Central Helpline & WhatsApp Operations Desk
KODAD_HELPLINE_PRIMARY=9640103505
KODAD_HELPLINE_SECONDARY=9182348241
