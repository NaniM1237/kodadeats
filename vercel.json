{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/*.js": {
      "includeFiles": "{data.js,realtime-sync.js,manifest.json,sw.js,icon.svg,*.png,*.jpg,*.webp,*.html}"
    }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/captain", "destination": "/captain.html" },
    { "source": "/restaurant", "destination": "/restaurant.html" }
  ]
}
